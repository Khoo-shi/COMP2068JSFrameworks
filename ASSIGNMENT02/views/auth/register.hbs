<section class="form-page">

<div class="container">

<div class="form-card">

<h1>Create Account</h1>

{{#if errorMessage}}
<div class="alert alert-danger">
{{errorMessage}}
</div>
{{/if}}

<form action="/register" method="POST">

<div class="mb-3">
<label>Name</label>

<input
class="form-control"
name="name"
required
value="{{formData.name}}">
</div>

<div class="mb-3">
<label>Email</label>

<input
type="email"
class="form-control"
name="email"
required
value="{{formData.email}}">
</div>

<div class="mb-3">
<label>Password</label>

<input
type="password"
class="form-control"
name="password"
required>
</div>

<div class="mb-3">
<label>Confirm Password</label>

<input
type="password"
class="form-control"
name="confirmPassword"
required>
</div>

<button
class="btn btn-primary"
type="submit">

Create Account

</button>
<div class="mt-3">
  <a href="/auth/github" class="btn btn-dark">
    Continue with GitHub
  </a>
</div>

</form>

</div>

</div>

</section>