<section class="directory-hero">
  <div class="container">
    <p class="eyebrow">LOCAL COMMUNITY SUPPORT</p>

    <h1>{{title}}</h1>

    <p>
      Browse services that support education, employment, housing,
      health, settlement and everyday community needs.
    </p>
  </div>
</section>

<section class="resource-directory">
  <div class="container">

    <div class="directory-heading">
      <div>
        <h2>Available Services</h2>
        <form action="/resources" method="GET" class="mb-4">

<div class="input-group">

<input
type="text"
name="search"
class="form-control"
placeholder="Search by name, category or city..."
value="{{search}}">

<button
class="btn btn-primary"
type="submit">

Search

</button>

</div>

</form>
        <p>Explore the resources currently listed in our directory.</p>
      </div>
{{#if currentUser}}
  <a href="/resources/new" class="btn btn-primary">
    Add Resource
  </a>
{{/if}}
    </div>

    {{#if resources.length}}
      <div class="resource-grid">

        {{#each resources}}
          <article class="resource-card">

            <div class="resource-card-header">
              <span class="category-badge">
                {{category}}
              </span>

              {{#if isFree}}
                <span class="free-badge">
                  Free
                </span>
              {{/if}}
            </div>

            <h3>{{name}}</h3>

            <p class="resource-description">
              {{description}}
            </p>

            <div class="resource-details">
              <p>
                <strong>Location:</strong>
                {{address}}, {{city}}
              </p>

              {{#if phone}}
                <p>
                  <strong>Phone:</strong>
                  {{phone}}
                </p>
              {{/if}}
            </div>

            {{#if website}}
              <a
                class="resource-link"
                href="{{website}}"
                target="_blank"
                rel="noopener noreferrer"
              >
                Visit website
              </a>
            {{/if}}

            {{#if ../currentUser}}
<div class="resource-actions">
  <a
    href="/resources/{{_id}}/edit"
    class="btn btn-sm btn-outline-primary"
  >
    Edit
  </a>

  <a
    href="/resources/{{_id}}/delete"
    class="btn btn-sm btn-outline-danger"
  >
    Delete
  </a>
</div>
{{/if}}

          </article>
        {{/each}}

      </div>
    {{else}}
      <div class="empty-directory">
        <h3>No resources are listed yet</h3>

        <p>
          Community resources will appear here after they are added.
        </p>
      </div>
    {{/if}}

  </div>
</section>